# ------------------------------------------------------------------------------
# Build Stage: cross-compile for s390x (IBM z/Architecture)
# ------------------------------------------------------------------------------

FROM --platform=${BUILDPLATFORM} rust:1.88 AS limitador-build

# libssl3/libssl-dev must be the same version on amd64 and s390x (Multi-Arch: same),
# but Debian's security pocket can publish a new libssl3 build for one architecture
# before the other, so neither side's candidate is reliably installable on its own.
# Pin both to the highest version available for BOTH architectures, and allow
# downgrading the native amd64 package in case `apt-get upgrade -y` moved it ahead
# of what's currently available for s390x.
RUN dpkg --add-architecture s390x \
    && apt-get update \
    && apt-get upgrade -y \
    && SSL_VER="$( { apt-cache madison libssl3 | awk '{print $3}' | sort -u; apt-cache madison libssl3:s390x | awk '{print $3}' | sort -u; } | sort | uniq -d | sort -V | tail -n1 )" \
    && apt-get install -y --no-install-recommends --allow-downgrades protobuf-compiler clang \
        gcc-s390x-linux-gnu g++-s390x-linux-gnu libc6-dev-s390x-cross pkg-config \
        "libssl3=${SSL_VER}" "libssl3:s390x=${SSL_VER}" "libssl-dev=${SSL_VER}" "libssl-dev:s390x=${SSL_VER}"

RUN rustup target add s390x-unknown-linux-gnu

WORKDIR /usr/src/limitador

ARG GITHUB_SHA
ENV GITHUB_SHA=${GITHUB_SHA:-unknown}
ENV RUSTFLAGS="-C target-feature=-crt-static" \
    CARGO_TARGET_S390X_UNKNOWN_LINUX_GNU_LINKER=s390x-linux-gnu-gcc \
    CC_s390x_unknown_linux_gnu=s390x-linux-gnu-gcc \
    CXX_s390x_unknown_linux_gnu=s390x-linux-gnu-g++ \
    BINDGEN_EXTRA_CLANG_ARGS="--sysroot=/usr/s390x-linux-gnu" \
    OPENSSL_LIB_DIR=/usr/lib/s390x-linux-gnu \
    OPENSSL_INCLUDE_DIR=/usr/include/s390x-linux-gnu \
    PKG_CONFIG_SYSROOT_DIR=/usr/s390x-linux-gnu \
    PKG_CONFIG_PATH=/usr/lib/s390x-linux-gnu/pkgconfig \
    PKG_CONFIG_ALLOW_CROSS=1

COPY . .

RUN cargo build --release --target s390x-unknown-linux-gnu

# ------------------------------------------------------------------------------
# Run Stage (UBI10 minimal has s390x variant)
# ------------------------------------------------------------------------------

FROM registry.access.redhat.com/ubi10/ubi-minimal:10.1

# shadow-utils is required for `useradd`
RUN PKGS="libgcc libstdc++ shadow-utils" \
    && microdnf --assumeyes install --nodocs $PKGS \
    && rpm --verify --nogroup --nouser $PKGS \
    && microdnf -y clean all
RUN useradd -u 1000 -s /bin/sh -m -d /home/limitador limitador

WORKDIR /home/limitador/bin/
ENV PATH="/home/limitador/bin:${PATH}"

COPY --from=limitador-build /usr/src/limitador/limitador-server/examples/limits.yaml ../
COPY --from=limitador-build /usr/src/limitador/target/s390x-unknown-linux-gnu/release/limitador-server ./limitador-server

RUN chown -R limitador:root /home/limitador \
    && chmod -R 750 /home/limitador

USER limitador

ENTRYPOINT ["limitador-server"]
